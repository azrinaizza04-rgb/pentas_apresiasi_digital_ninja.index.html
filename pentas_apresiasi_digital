    <script>
        /* Fruit Object Class */
        class Fruit {
            constructor(x, y, vx, vy, fruitType, text, isCorrect) {
                this.x = x;
                this.y = y;
                this.vx = vx;
                this.vy = vy;
                this.radius = 65; // Size radius
                this.fruitType = fruitType; // "watermelon", "banana", "apple"
                this.text = text;
                this.isCorrect = isCorrect;
                this.isSliced = false;
                this.sliceAngle = 0;
                
                // Floating wiggle motion variables
                this.wiggleOffset = Math.random() * Math.PI * 2;
                this.rotation = (Math.random() - 0.5) * 0.2;
                this.currentRotation = 0;

                // Halves physics if sliced
                this.sliceLeft = null;
                this.sliceRight = null;
            }

            update(width, height) {
                if (!this.isSliced) {
                    // Update positions with floating momentum
                    this.x += this.vx;
                    this.y += this.vy;

                    // Bounce off sides
                    if (this.x - this.radius < 20 || this.x + this.radius > width - 20) {
                        this.vx *= -1;
                    }
                    if (this.y - this.radius < 120 || this.y + this.radius > height - 60) {
                        this.vy *= -1;
                    }

                    // Floating slight sine wave
                    this.wiggleOffset += 0.03;
                    this.currentRotation += Math.sin(this.wiggleOffset) * 0.005;
                } else {
                    // Sliced halves physics
                    if (this.sliceLeft && this.sliceRight) {
                        this.sliceLeft.x += this.sliceLeft.vx;
                        this.sliceLeft.y += this.sliceLeft.vy;
                        this.sliceLeft.vy += 0.4; // Gravity
                        this.sliceLeft.rot += 0.05;

                        this.sliceRight.x += this.sliceRight.vx;
                        this.sliceRight.y += this.sliceRight.vy;
                        this.sliceRight.vy += 0.4; // Gravity
                        this.sliceRight.rot -= 0.05;
                    }
                }
            }

            draw(ctx) {
                ctx.save();

                if (!this.isSliced) {
                    ctx.translate(this.x, this.y);
                    ctx.rotate(this.currentRotation);

                    // Draw Fruit Base Graphic
                    this.drawFruitGraphic(ctx, 0, 0, this.radius, this.fruitType);

                    // Draw Answer Text Badge below/inside fruit
                    ctx.restore();
                    this.drawTextOverlay(ctx);
                } else {
                    // Draw sliced halves falling apart
                    if (this.sliceLeft) {
                        ctx.save();
                        ctx.translate(this.sliceLeft.x, this.sliceLeft.y);
                        ctx.rotate(this.sliceLeft.rot);
                        this.drawHalfFruit(ctx, this.fruitType, 'left');
                        ctx.restore();
                    }
                    if (this.sliceRight) {
                        ctx.save();
                        ctx.translate(this.sliceRight.x, this.sliceRight.y);
                        ctx.rotate(this.sliceRight.rot);
                        this.drawHalfFruit(ctx, this.fruitType, 'right');
                        ctx.restore();
                    }
                    ctx.restore();
                }
            }

            drawFruitGraphic(ctx, x, y, r, type) {
                ctx.save();
                ctx.beginPath();

                if (type === 'watermelon') {
                    // Green striped rind
                    ctx.arc(x, y, r, 0, Math.PI * 2);
                    ctx.fillStyle = '#2e7d32';
                    ctx.fill();
                    ctx.lineWidth = 6;
                    ctx.strokeStyle = '#1b5e20';
                    ctx.stroke();

                    // Juicy Red Center
                    ctx.beginPath();
                    ctx.arc(x, y, r * 0.82, 0, Math.PI * 2);
                    ctx.fillStyle = '#ff1744';
                    ctx.fill();

                    // Black Seeds
                    ctx.fillStyle = '#000000';
                    const seeds = [
                        {x: -18, y: -12}, {x: 18, y: -12},
                        {x: -22, y: 15}, {x: 22, y: 15},
                        {x: 0, y: -25}, {x: 0, y: 25}
                    ];
                    seeds.forEach(s => {
                        ctx.beginPath();
                        ctx.arc(x + s.x, y + s.y, 3.5, 0, Math.PI * 2);
                        ctx.fill();
                    });

                } else if (type === 'banana') {
                    // Curved Golden Banana
                    ctx.fillStyle = '#ffd600';
                    ctx.strokeStyle = '#f57f17';
                    ctx.lineWidth = 4;
                    
                    ctx.beginPath();
                    ctx.ellipse(x, y, r * 1.1, r * 0.65, -0.2, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.stroke();

                    // Banana tip
                    ctx.fillStyle = '#4e342e';
                    ctx.beginPath();
                    ctx.arc(x - r * 0.9, y - r * 0.2, 7, 0, Math.PI * 2);
                    ctx.fill();

                } else if (type === 'apple') {
                    // Shiny Red Apple
                    ctx.fillStyle = '#d50000';
                    ctx.strokeStyle = '#b71c1c';
                    ctx.lineWidth = 5;

                    ctx.beginPath();
                    ctx.arc(x - r * 0.25, y - r * 0.1, r * 0.7, 0, Math.PI * 2);
                    ctx.arc(x + r * 0.25, y - r * 0.1, r * 0.7, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.stroke();

                    // Brown Stem & Leaf
                    ctx.fillStyle = '#5d4037';
                    ctx.fillRect(x - 3, y - r - 8, 6, 14);

                    ctx.fillStyle = '#76ff03';
                    ctx.beginPath();
                    ctx.ellipse(x + 8, y - r - 4, 10, 5, 0.4, 0, Math.PI * 2);
                    ctx.fill();
                }

                // Shiny Gloss highlight
                ctx.beginPath();
                ctx.arc(x - r * 0.35, y - r * 0.35, r * 0.2, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
                ctx.fill();

                ctx.restore();
            }

            drawTextOverlay(ctx) {
                ctx.save();
                // Text background capsule badge
                const fontHeight = 16;
                ctx.font = '900 15px Outfit, sans-serif';
                const textWidth = ctx.measureText(this.text).width;
                const paddingX = 18;
                const paddingY = 10;

                const badgeX = this.x - textWidth / 2 - paddingX / 2;
                const badgeY = this.y + this.radius + 8;

                // Draw Badge Frame
                ctx.fillStyle = 'rgba(15, 23, 42, 0.95)';
                ctx.strokeStyle = this.getFruitThemeColor(this.fruitType);
                ctx.lineWidth = 3;
                
                ctx.beginPath();
                ctx.roundRect(badgeX, badgeY, textWidth + paddingX, fontHeight + paddingY, 12);
                ctx.fill();
                ctx.stroke();

                // Draw Text
                ctx.fillStyle = '#FFFFFF';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(this.text, this.x, badgeY + (fontHeight + paddingY) / 2);

                ctx.restore();
            }

            drawHalfFruit(ctx, type, side) {
                const r = this.radius;
                ctx.save();
                ctx.clip();
                ctx.beginPath();
                if (side === 'left') {
                    ctx.rect(-r * 1.5, -r * 1.5, r * 1.5, r * 3);
                } else {
                    ctx.rect(0, -r * 1.5, r * 1.5, r * 3);
                }
                ctx.clip();

                this.drawFruitGraphic(ctx, 0, 0, r, type);
                ctx.restore();
            }

            getFruitThemeColor(type) {
                if (type === 'watermelon') return '#FF2E93';
                if (type === 'banana') return '#FFD200';
                return '#FF1744';
            }

            slice(angle, sliceX, sliceY) {
                this.isSliced = true;
                this.sliceAngle = angle;

                // Create 2 half fruit objects
                const speed = 6;
                this.sliceLeft = {
                    x: this.x,
                    y: this.y,
                    vx: -Math.cos(angle) * speed - 2,
                    vy: -Math.sin(angle) * speed - 2,
                    rot: 0
                };
                this.sliceRight = {
                    x: this.x,
                    y: this.y,
                    vx: Math.cos(angle) * speed + 2,
                    vy: Math.sin(angle) * speed - 2,
                    rot: 0
                };

                // Spawn Particles Burst
                spawnJuiceParticles(sliceX, sliceY, this.getFruitThemeColor(this.fruitType));
            }
        }

        /* Particle Splash Effects */
        class JuiceParticle {
            constructor(x, y, color) {
                this.x = x;
                this.y = y;
                this.color = color;
                this.radius = Math.random() * 6 + 3;
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 10 + 3;
                this.vx = Math.cos(angle) * speed;
                this.vy = Math.sin(angle) * speed;
                this.alpha = 1;
                this.gravity = 0.35;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.vy += this.gravity;
                this.alpha -= 0.025;
            }

            draw(ctx) {
                ctx.save();
                ctx.globalAlpha = Math.max(0, this.alpha);
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        function spawnJuiceParticles(x, y, color) {
            for (let i = 0; i < 25; i++) {
                particles.push(new JuiceParticle(x, y, color));
            }
        }
    </script>

    <script>
        /* Initialize MediaPipe Hands */
        function initMediaPipe() {
            const videoElement = document.getElementById('webcamVideo');

            handsObj = new Hands({
                locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
            });

            handsObj.setOptions({
                maxNumHands: 1,
                modelComplexity: 1,
                minDetectionConfidence: 0.65,
                minTrackingConfidence: 0.65
            });

            handsObj.onResults((results) => {
                if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
                    const landmarks = results.multiHandLandmarks[0];
                    
                    // Landmark 8 is the Index Finger Tip
                    const indexTip = landmarks[8];

                    // Convert mirrored camera coords to screen coords
                    const screenX = (1 - indexTip.x) * canvas.width;
                    const screenY = indexTip.y * canvas.height;

                    // Smooth transition (lerp)
                    prevFingerPos.x = fingerPos.x;
                    prevFingerPos.y = fingerPos.y;

                    fingerPos.x += (screenX - fingerPos.x) * 0.5;
                    fingerPos.y += (screenY - fingerPos.y) * 0.5;

                    // Add point to Blade Trail
                    bladeTrail.push({
                        x: fingerPos.x,
                        y: fingerPos.y,
                        time: performance.now()
                    });
                }
            });
        }

        /* Toggle Webcam Feed */
        async function toggleWebcam() {
            ninjaAudio.init();
            const btnText = document.getElementById('camBtnText');
            const camIcon = document.getElementById('camIcon');

            if (isWebcamActive) {
                if (cameraObj) await cameraObj.stop();
                isWebcamActive = false;
                btnText.innerText = 'Aktifkan Kamera';
                camIcon.className = 'fa-solid fa-video';
            } else {
                try {
                    btnText.innerText = 'Memuatkan...';
                    if (!handsObj) initMediaPipe();

                    const videoElement = document.getElementById('webcamVideo');
                    cameraObj = new Camera(videoElement, {
                        onFrame: async () => {
                            await handsObj.send({ image: videoElement });
                        },
                        width: 1280,
                        height: 720
                    });

                    await cameraObj.start();
                    isWebcamActive = true;
                    btnText.innerText = 'Kamera Aktif';
                    camIcon.className = 'fa-solid fa-video-slash text-green-400';
                } catch (err) {
                    console.error('Kamera Error:', err);
                    btnText.innerText = 'Gagal Kamera';
                    alert('Tidak dapat mengaktifkan kamera. Anda boleh terus bermain guna tetikus/skrin sentuh!');
                }
            }
        }

        /* Line Segment vs Circle Collision Detection for Slicing */
        function checkSliceCollision(p1, p2, fruit) {
            if (fruit.isSliced) return false;

            // Distance between line segment (p1, p2) and fruit center
            const dx = p2.x - p1.x;
            const dy = p2.y - p1.y;
            const len = Math.sqrt(dx * dx + dy * dy);

            if (len < 5) return false; // Must be a deliberate slice motion

            const u = ((fruit.x - p1.x) * dx + (fruit.y - p1.y) * dy) / (len * len);
            const clampedU = Math.max(0, Math.min(1, u));

            const nearestX = p1.x + clampedU * dx;
            const nearestY = p1.y + clampedU * dy;

            const dist = Math.sqrt((fruit.x - nearestX) ** 2 + (fruit.y - nearestY) ** 2);

            return dist < fruit.radius;
        }
    </script>

    <script>
        /* Setup Canvas and Animation Loop */
        window.onload = function() {
            canvas = document.getElementById('gameCanvas');
            ctx = canvas.getContext('2d');

            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);

            setupMouseTouchEvents();

            // Start Main Game Render Loop
            requestAnimationFrame(gameLoop);
        };

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        /* Mouse & Touch Slicing Fallback */
        let isMouseDown = false;

        function setupMouseTouchEvents() {
            window.addEventListener('mousemove', (e) => {
                if (!isWebcamActive) {
                    prevFingerPos.x = fingerPos.x;
                    prevFingerPos.y = fingerPos.y;
                    fingerPos.x = e.clientX;
                    fingerPos.y = e.clientY;

                    if (isMouseDown) {
                        bladeTrail.push({
                            x: fingerPos.x,
                            y: fingerPos.y,
                            time: performance.now()
                        });
                    }
                }
            });

            window.addEventListener('mousedown', (e) => {
                ninjaAudio.init();
                isMouseDown = true;
                fingerPos.x = e.clientX;
                fingerPos.y = e.clientY;
            });

            window.addEventListener('mouseup', () => {
                isMouseDown = false;
            });

            window.addEventListener('touchmove', (e) => {
                if (!isWebcamActive && e.touches.length > 0) {
                    prevFingerPos.x = fingerPos.x;
                    prevFingerPos.y = fingerPos.y;
                    fingerPos.x = e.touches[0].clientX;
                    fingerPos.y = e.touches[0].clientY;

                    bladeTrail.push({
                        x: fingerPos.x,
                        y: fingerPos.y,
                        time: performance.now()
                    });
                }
            }, { passive: true });

            window.addEventListener('touchstart', (e) => {
                ninjaAudio.init();
                if (!isWebcamActive && e.touches.length > 0) {
                    fingerPos.x = e.touches[0].clientX;
                    fingerPos.y = e.touches[0].clientY;
                }
            }, { passive: true });
        }

        /* Start Game */
        function startGame() {
            ninjaAudio.init();
            currentQuestionIndex = 0;
            score = 0;
            lives = 3;
            isGameActive = true;

            document.getElementById('startModal').classList.add('hidden');
            document.getElementById('resultModal').classList.add('hidden');

            updateHUD();
            spawnQuestionFruits();
        }

        /* Spawn 3 Fruits corresponding to current question options */
        function spawnQuestionFruits() {
            fruits = [];
            const q = QUESTIONS[currentQuestionIndex];

            document.getElementById('questionNumText').innerText = `Soalan ${currentQuestionIndex + 1} / 5`;
            document.getElementById('questionText').innerText = q.question;

            const w = canvas.width;
            const h = canvas.height;

            // Define 3 spread out initial position slots across screen
            const slots = [
                { x: w * 0.25, y: h * 0.55 },
                { x: w * 0.50, y: h * 0.60 },
                { x: w * 0.75, y: h * 0.55 }
            ];

            // Shuffle options slightly so position isn't predictable
            const shuffledOptions = shuffleArray([...q.options]);

            shuffledOptions.forEach((opt, idx) => {
                const slot = slots[idx];
                const vx = (Math.random() - 0.5) * 2;
                const vy = (Math.random() - 0.5) * 2;

                fruits.push(new Fruit(
                    slot.x, slot.y, vx, vy, opt.fruitType, opt.text, opt.isCorrect
                ));
            });
        }

        /* Main Game Animation Loop */
        function gameLoop(timestamp) {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // 1. Draw Live Webcam Feed onto Canvas background (Mirrored)
            const video = document.getElementById('webcamVideo');
            if (isWebcamActive && video.readyState === 4) {
                ctx.save();
                ctx.translate(canvas.width, 0);
                ctx.scale(-1, 1); // Mirror feed naturally
                ctx.globalAlpha = 0.45; // Subtle camera background opacity
                ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                ctx.restore();
            }

            if (isGameActive) {
                // 2. Update & Draw Fruits
                fruits.forEach(fruit => {
                    fruit.update(canvas.width, canvas.height);
                    fruit.draw(ctx);
                });

                // 3. Update & Draw Juice Particles
                for (let i = particles.length - 1; i >= 0; i--) {
                    particles[i].update();
                    particles[i].draw(ctx);
                    if (particles[i].alpha <= 0) particles.splice(i, 1);
                }

                // 4. Check Slicing Collision between Blade Trail and Fruits
                if (bladeTrail.length >= 2) {
                    const p1 = bladeTrail[bladeTrail.length - 2];
                    const p2 = bladeTrail[bladeTrail.length - 1];

                    fruits.forEach(fruit => {
                        if (checkSliceCollision(p1, p2, fruit)) {
                            const angle = Math.atan2(p2.y - p1.y, p2.x - p1.x);
                            fruit.slice(angle, p2.x, p2.y);
                            handleFruitSlice(fruit);
                        }
                    });
                }
            }

            // 5. Clean up old Blade Trail points
            const now = performance.now();
            bladeTrail = bladeTrail.filter(pt => now - pt.time < 200);

            // 6. Draw Glowing Ninja Blade Trail
            drawBladeTrail(ctx);

            requestAnimationFrame(gameLoop);
        }

        /* Render Ninja Blade Slash Trail */
        function drawBladeTrail(ctx) {
            if (bladeTrail.length < 2) return;

            ctx.save();
            ctx.beginPath();
            ctx.moveTo(bladeTrail[0].x, bladeTrail[0].y);

            for (let i = 1; i < bladeTrail.length; i++) {
                ctx.lineTo(bladeTrail[i].x, bladeTrail[i].y);
            }

            // Glowing Magenta / Cyan Laser Blade
            ctx.strokeStyle = '#00E5FF';
            ctx.lineWidth = 8;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.shadowColor = '#FF2E93';
            ctx.shadowBlur = 15;
            ctx.stroke();

            // Inner White Hot Core
            ctx.strokeStyle = '#FFFFFF';
            ctx.lineWidth = 3;
            ctx.stroke();

            ctx.restore();
        }

        /* Handle Fruit Slice Evaluation */
        function handleFruitSlice(fruit) {
            const overlay = document.getElementById('flashOverlay');
            const mainBody = document.body;

            if (fruit.isCorrect) {
                // CORRECT FRUIT CUT! (+20 Marks)
                ninjaAudio.playCorrectSlice();
                score += 20;

                overlay.className = 'fixed inset-0 pointer-events-none z-50 flash-green-screen';
                setTimeout(() => overlay.className = 'fixed inset-0 pointer-events-none z-50', 500);

                updateHUD();

                // Advance to next question after short split delay
                setTimeout(() => {
                    currentQuestionIndex++;
                    if (currentQuestionIndex < QUESTIONS.length) {
                        spawnQuestionFruits();
                    } else {
                        endGame(true);
                    }
                }, 800);

            } else {
                // WRONG FRUIT CUT! (-1 Life)
                ninjaAudio.playWrongSlice();
                lives--;

                overlay.className = 'fixed inset-0 pointer-events-none z-50 flash-red-screen';
                mainBody.classList.add('shake-screen');

                setTimeout(() => {
                    overlay.className = 'fixed inset-0 pointer-events-none z-50';
                    mainBody.classList.remove('shake-screen');
                }, 500);

                updateHUD();

                if (lives <= 0) {
                    setTimeout(() => endGame(false), 800);
                }
            }
        }

        /* Update HUD Hearts & Score */
        function updateHUD() {
            document.getElementById('scoreDisplay').innerText = score;

            const container = document.getElementById('livesContainer');
            container.innerHTML = '';
            for (let i = 0; i < 3; i++) {
                if (i < lives) {
                    container.innerHTML += '<i class="fa-solid fa-heart text-pink-500 drop-shadow-[0_0_8px_rgba(255,46,147,0.8)]"></i>';
                } else {
                    container.innerHTML += '<i class="fa-solid fa-heart text-slate-700"></i>';
                }
            }
        }

        /* End Game Screen */
        function endGame(isVictory) {
            isGameActive = false;

            const resultModal = document.getElementById('resultModal');
            const resultEmoji = document.getElementById('resultEmoji');
            const resultTitle = document.getElementById('resultTitle');
            const resultSubtitle = document.getElementById('resultSubtitle');
            const finalScoreText = document.getElementById('finalScoreText');
            const resultBadge = document.getElementById('resultBadge');
            const resultFeedback = document.getElementById('resultFeedback');

            finalScoreText.innerText = `${score} / 100`;
            resultModal.classList.remove('hidden');

            if (isVictory) {
                ninjaAudio.playVictory();
                triggerConfetti();

                resultEmoji.innerText = '🏆';
                resultTitle.innerText = 'TAHNIAH SLICE NINJA!';
                resultSubtitle.innerText = 'Anda telah menyelesaikan kelima-lima soalan Apresiasi Seni!';
                resultBadge.innerText = 'MASTER NINJA APRESIASI';
                resultBadge.className = 'inline-block bg-green-500/30 text-green-300 font-bold text-xs px-3 py-1 rounded-full border border-green-500/40';
                
                resultFeedback.innerText = '"Syabas! Anda telah berjaya mengenal pasti Penanda Buku Alam, Teknik Kolaj, 4 Bahasa Seni Visual, Unsur Warna & Jalinan, serta Prinsip Kepelbagaian & Kontra dengan cemerlang!"';
            } else {
                resultEmoji.innerText = '⚔️';
                resultTitle.innerText = 'CUBA LAGI NINJA!';
                resultTitle.innerText = 'NYAWA ANDA TELAH HABIS!';
                resultSubtitle.innerText = 'Jangan berputus asa. Ulangi latihan untuk menguasai soalan seni!';
                resultBadge.innerText = 'LATIHAN DITERUSKAN';
                resultBadge.className = 'inline-block bg-pink-500/30 text-pink-300 font-bold text-xs px-3 py-1 rounded-full border border-pink-500/40';

                resultFeedback.innerText = '"Ingat: Penanda buku menggunakan Teknik Kolaj, ada 4 Bahasa Seni Visual, Unsur Warna & Jalinan, serta Prinsip Kepelbagaian & Kontra!"';
            }
        }

        /* Reset Game */
        function resetGame() {
            document.getElementById('resultModal').classList.add('hidden');
            startGame();
        }

        /* Utility Shuffle */
        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }

        /* Confetti Burst */
        function triggerConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 120,
                    spread: 80,
                    origin: { y: 0.6 }
                });
            }
        }
    </script>
